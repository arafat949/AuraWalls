<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface"
    android:gravity="center"
    android:paddingTop="24dp"
    android:paddingBottom="40dp"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <!-- Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="#44ffffff"
        android:layout_marginBottom="24dp"/>

    <!-- Success emoji -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✅"
        android:textSize="56sp"
        android:layout_marginBottom="16dp"/>

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Wallpaper Set!"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="8dp"/>

    <!-- Message -->
    <TextView
        android:id="@+id/tv_success_msg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your wallpaper has been set successfully."
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:layout_marginBottom="32dp"/>

    <!-- Share Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_share_success"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="🔗  Share This Wallpaper"
        android:textSize="14sp"
        android:textColor="@color/primary"
        app:cornerRadius="25dp"
        app:strokeColor="@color/primary"
        app:strokeWidth="1dp"
        app:backgroundTint="#1A7C6FFF"
        android:layout_marginBottom="12dp"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

    <!-- Close Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_close_success"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Done"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cornerRadius="25dp"
        app:backgroundTint="@color/primary"/>

</LinearLayout>
