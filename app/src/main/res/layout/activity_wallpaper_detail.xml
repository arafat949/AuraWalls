<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingBottom="24dp">

        <FrameLayout android:layout_width="match_parent" android:layout_height="480dp">
            <ImageView android:id="@+id/iv_preview" android:layout_width="match_parent"
                android:layout_height="match_parent" android:scaleType="centerCrop"/>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="top|end" android:orientation="vertical" android:padding="8dp">
                <ImageButton android:id="@+id/btn_favorite"
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:background="#88000000" android:padding="8dp"
                    android:src="@android:drawable/btn_star_big_off"/>
                <ImageButton android:id="@+id/btn_share"
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="#88000000" android:padding="8dp"
                    android:src="@android:drawable/ic_menu_share"/>
            </LinearLayout>
        </FrameLayout>

        <TextView android:id="@+id/tv_attribution" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:padding="12dp"
            android:textSize="12sp" android:textColor="@color/text_secondary"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp"
            android:text="🎨 Color Palette — tap to copy"
            android:textStyle="bold" android:textSize="13sp" android:textColor="@color/text_primary"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:padding="12dp" android:weightSum="5">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <View android:id="@+id/pal1" android:layout_width="44dp" android:layout_height="44dp"/>
                <TextView android:id="@+id/pal1_hex" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="8sp" android:textColor="@color/text_secondary" android:text="#000000"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <View android:id="@+id/pal2" android:layout_width="44dp" android:layout_height="44dp"/>
                <TextView android:id="@+id/pal2_hex" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="8sp" android:textColor="@color/text_secondary" android:text="#000000"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <View android:id="@+id/pal3" android:layout_width="44dp" android:layout_height="44dp"/>
                <TextView android:id="@+id/pal3_hex" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="8sp" android:textColor="@color/text_secondary" android:text="#000000"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <View android:id="@+id/pal4" android:layout_width="44dp" android:layout_height="44dp"/>
                <TextView android:id="@+id/pal4_hex" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="8sp" android:textColor="@color/text_secondary" android:text="#000000"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <View android:id="@+id/pal5" android:layout_width="44dp" android:layout_height="44dp"/>
                <TextView android:id="@+id/pal5_hex" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="8sp" android:textColor="@color/text_secondary" android:text="#000000"/>
            </LinearLayout>
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/btn_unlock_filters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#1A1A2E">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:background="@drawable/gradient_unlock_bg">
                <FrameLayout android:layout_width="52dp" android:layout_height="52dp"
                    android:background="@drawable/circle_play_bg">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_media_play"
                        android:tint="#FFFFFF"/>
                </FrameLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical"
                    android:paddingStart="14dp" android:paddingEnd="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Unlock Filters" android:textColor="#FFFFFF"
                        android:textSize="15sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Watch an ad — completely free"
                        android:textColor="#B0B0CC" android:textSize="11sp" android:layout_marginTop="2dp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="FREE" android:textColor="#FFD700" android:textSize="10sp"
                        android:textStyle="bold" android:background="#33FFD700"
                        android:paddingStart="8dp" android:paddingEnd="8dp"
                        android:paddingTop="3dp" android:paddingBottom="3dp"/>
                    <ImageView android:layout_width="22dp" android:layout_height="22dp"
                        android:src="@android:drawable/ic_media_next"
                        android:tint="#7C4DFF" android:layout_marginTop="4dp"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <LinearLayout android:id="@+id/filter_panel" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:padding="16dp" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="💧 Blur" android:textStyle="bold" android:textColor="@color/text_primary"/>
            <SeekBar android:id="@+id/sb_blur" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:max="25" android:progress="0"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="☀️ Brightness" android:textStyle="bold" android:textColor="@color/text_primary"
                android:layout_marginTop="12dp"/>
            <SeekBar android:id="@+id/sb_brightness" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:max="100" android:progress="50"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🖤 Grayscale" android:textStyle="bold" android:textColor="@color/text_primary"
                android:layout_marginTop="12dp"/>
            <SeekBar android:id="@+id/sb_grayscale" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:max="100" android:progress="0"/>
        </LinearLayout>

                <!-- Action Buttons — Save + Set Wallpaper -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_download"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:text="💾 Save"
                android:textSize="14sp"
                android:textColor="#7C6FFF"
                app:cornerRadius="28dp"
                app:strokeColor="#7C6FFF"
                app:strokeWidth="1dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_set_both"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="2"
                android:text="📱 Set Wallpaper"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                app:cornerRadius="28dp"
                app:backgroundTint="#7C6FFF"/>

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>