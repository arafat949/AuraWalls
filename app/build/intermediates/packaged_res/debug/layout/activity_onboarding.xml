<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--                     SWIPE PANEL                            -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/swipe_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="আপনার Aura খুঁজে বের করুন ✨"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:paddingTop="24dp"
            android:paddingBottom="8dp"/>

        <TextView
            android:id="@+id/tv_step"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ছবিটি কি আপনার পছন্দ?"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:paddingBottom="16dp"/>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/pb_onboarding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:indeterminate="false"
            app:indicatorColor="@color/primary"
            app:trackColor="@color/surface_variant"/>

        <TextView
            android:id="@+id/tv_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1 / 3"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:gravity="end"
            android:paddingBottom="12dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:cardCornerRadius="24dp"
            app:cardElevation="12dp">

            <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/iv_onboarding_card"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="Onboarding image"/>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/gradient_bottom_black"/>
                <TextView
                    android:id="@+id/tv_card_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:padding="20dp"
                    android:text="সোনালি আলো"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:shadowColor="#99000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="8"/>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="20dp"
            android:paddingBottom="8dp"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_skip"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="👎  না"
                android:textSize="18sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:cornerRadius="28dp"
                app:strokeColor="@color/text_secondary"
                app:strokeWidth="1dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_like"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="❤️  হ্যাঁ"
                android:textSize="18sp"
                app:cornerRadius="28dp"
                app:backgroundTint="@color/primary"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--                     RESULT PANEL                           -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/result_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- 1. Full bleed dynamic background image -->
        <ImageView
            android:id="@+id/iv_result_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Result background"/>

        <!-- 2. Dark gradient overlay -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/result_bg_overlay"/>

        <!-- 3. Centered content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="48dp"
            android:paddingBottom="32dp">

                <!-- ── Dynamic Aura Icon: circle with Pexels image + emoji ── -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_aura_icon"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    app:cardCornerRadius="60dp"
                    app:cardElevation="20dp"
                    app:strokeWidth="3dp"
                    app:strokeColor="#99ffffff">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <!-- Pexels image (aura type specific) -->
                        <ImageView
                            android:id="@+id/iv_aura_icon"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:contentDescription="Aura icon image"/>

                        <!-- Semi-transparent overlay so emoji pops -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#44000000"/>

                        <!-- Emoji centered on top -->
                        <TextView
                            android:id="@+id/tv_aura_emoji"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="🌙"
                            android:textSize="46sp"/>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Subtitle -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="আপনার Aura হলো"
                    android:textSize="15sp"
                    android:textColor="#CCffffff"
                    android:letterSpacing="0.06"
                    android:layout_marginTop="14dp"/>

                <!-- Aura Title with glow shadow -->
                <TextView
                    android:id="@+id/tv_aura_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Golden Hour Soul"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:shadowColor="#BB000000"
                    android:shadowDx="0"
                    android:shadowDy="4"
                    android:shadowRadius="16"/>

                <!-- Animated divider line -->
                <View
                    android:id="@+id/divider_aura"
                    android:layout_width="64dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="18dp"
                    android:background="#80ffffff"/>

                <!-- Description -->
                <TextView
                    android:id="@+id/tv_aura_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="#E0ffffff"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.8"
                    android:shadowColor="#88000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="8"/>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <!-- Share Button - Professional Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_share_aura"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="28dp"
                    app:cardCornerRadius="32dp"
                    app:cardElevation="10dp"
                    app:cardBackgroundColor="#30FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:background="@drawable/btn_share_aura_bg">

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/circle_share_bg">
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:src="@android:drawable/ic_menu_share"
                                android:tint="#FFFFFF"/>
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="14dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Share My Aura"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.04"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tell your friends about your vibe"
                                android:textColor="#CCFFFFFF"
                                android:textSize="10sp"
                                android:layout_marginTop="1dp"/>
                        </LinearLayout>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@android:drawable/ic_media_next"
                            android:tint="#AAFFFFFF"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Continue Button - Professional Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_continue"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="12dp"
                    app:cardCornerRadius="32dp"
                    app:cardElevation="14dp"
                    app:cardBackgroundColor="#7C4DFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:background="@drawable/btn_continue_bg">

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/circle_continue_bg">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@android:drawable/star_big_on"
                                android:tint="#FFD700"/>
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="14dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Explore AuraWalls"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.04"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Discover wallpapers made for you"
                                android:textColor="#EEFFFFFF"
                                android:textSize="10sp"
                                android:layout_marginTop="1dp"/>
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_media_next"
                            android:tint="#FFFFFF"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
    </FrameLayout>

</FrameLayout>