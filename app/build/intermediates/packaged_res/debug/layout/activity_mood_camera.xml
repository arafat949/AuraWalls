<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0E1A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#0D0E1A"
            app:titleTextColor="#FFFFFF"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center">

                <!-- Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="😊 Mood Detector"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scan your face — get a wallpaper that matches your mood"
                    android:textColor="#AAFFFFFF"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:layout_marginBottom="20dp"/>

                <!-- Camera Preview Frame -->
                <FrameLayout
                    android:layout_width="260dp"
                    android:layout_height="320dp"
                    android:layout_gravity="center">

                    <!-- Real CameraX Preview -->
                    <androidx.camera.view.PreviewView
                        android:id="@+id/preview_view"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone"/>

                    <!-- Placeholder before camera starts -->
                    <FrameLayout
                        android:id="@+id/face_placeholder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#1A6C63FF">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="🙂"
                            android:textSize="80sp"/>
                    </FrameLayout>

                    <!-- Corner decorations -->
                    <View android:layout_width="30dp" android:layout_height="4dp"
                        android:layout_gravity="top|start" android:background="#6C63FF"
                        android:layout_margin="12dp"/>
                    <View android:layout_width="4dp" android:layout_height="30dp"
                        android:layout_gravity="top|start" android:background="#6C63FF"
                        android:layout_margin="12dp"/>
                    <View android:layout_width="30dp" android:layout_height="4dp"
                        android:layout_gravity="top|end" android:background="#6C63FF"
                        android:layout_margin="12dp"/>
                    <View android:layout_width="4dp" android:layout_height="30dp"
                        android:layout_gravity="top|end" android:background="#6C63FF"
                        android:layout_margin="12dp"/>
                    <View android:layout_width="30dp" android:layout_height="4dp"
                        android:layout_gravity="bottom|start" android:background="#6C63FF"
                        android:layout_margin="12dp"/>
                    <View android:layout_width="4dp" android:layout_height="30dp"
                        android:layout_gravity="bottom|start" android:background="#6C63FF"
                        android:layout_margin="12dp"/>
                    <View android:layout_width="30dp" android:layout_height="4dp"
                        android:layout_gravity="bottom|end" android:background="#6C63FF"
                        android:layout_margin="12dp"/>
                    <View android:layout_width="4dp" android:layout_height="30dp"
                        android:layout_gravity="bottom|end" android:background="#6C63FF"
                        android:layout_margin="12dp"/>

                    <!-- Scan Overlay + Line -->
                    <FrameLayout
                        android:id="@+id/scan_overlay"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone"
                        android:background="#44000000">
                        <View
                            android:id="@+id/scan_line"
                            android:layout_width="match_parent"
                            android:layout_height="3dp"
                            android:layout_gravity="center_vertical"
                            android:background="#6C63FF"/>
                    </FrameLayout>

                </FrameLayout>

                <!-- Scan Status -->
                <TextView
                    android:id="@+id/tv_scan_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#6C63FF"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="16dp"/>

                <!-- Scan Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_scan"
                    android:layout_width="220dp"
                    android:layout_height="52dp"
                    android:text="📸  Scan My Mood"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="#6C63FF"
                    app:cornerRadius="26dp"
                    app:icon="@android:drawable/ic_menu_camera"
                    app:iconTint="#FFFFFF"
                    app:iconSize="18dp"
                    app:iconPadding="8dp"/>

                <!-- ML Kit badge -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Powered by Google ML Kit"
                    android:textColor="#55FFFFFF"
                    android:textSize="10sp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="8dp"/>

                <!-- Result Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/result_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:visibility="gone"
                    app:cardCornerRadius="20dp"
                    app:cardBackgroundColor="#1A1B2E"
                    app:strokeColor="#336C63FF"
                    app:strokeWidth="1dp"
                    app:cardElevation="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Detected Mood"
                            android:textColor="#AAFFFFFF"
                            android:textSize="12sp"
                            android:letterSpacing="0.1"/>

                        <TextView
                            android:id="@+id/tv_detected_mood"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFFFF"
                            android:textSize="30sp"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp"/>

                        <View
                            android:layout_width="48dp"
                            android:layout_height="2dp"
                            android:background="#446C63FF"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:id="@+id/tv_mood_desc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#CCFFFFFF"
                            android:textSize="13sp"
                            android:gravity="center"
                            android:lineSpacingMultiplier="1.5"/>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Apply Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_apply_mood"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="32dp"
                    android:text="🎨  Apply Mood Wallpaper"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:backgroundTint="#FF6584"
                    app:cornerRadius="26dp"/>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
